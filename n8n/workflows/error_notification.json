{
  "name": "error_notification",
  "active": false,
  "settings": {"executionOrder": "v1"},
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "error",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-error",
      "name": "Webhook Error",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "err-notify-01HXYZABCD000000000000003"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "1", "name": "received_at", "value": "={{$now.toISO()}}", "type": "string"},
            {"id": "2", "name": "dag_id", "value": "={{$json.body.dag_id}}", "type": "string"},
            {"id": "3", "name": "task_id", "value": "={{$json.body.task_id}}", "type": "string"},
            {"id": "4", "name": "run_id", "value": "={{$json.body.run_id}}", "type": "string"},
            {"id": "5", "name": "guid", "value": "={{$json.body.guid || 'N/D'}}", "type": "string"},
            {"id": "6", "name": "error", "value": "={{$json.body.error}}", "type": "string"},
            {"id": "7", "name": "severity", "value": "ERROR", "type": "string"},
            {"id": "8", "name": "destinatario", "value": "={{$json.body.destinatario || $env.CLINICO_EMAIL}}", "type": "string"},
            {"id": "9", "name": "asunto", "value": "=Fallo en el pipeline de triaje · DAG {{$json.body.dag_id}} · tarea {{$json.body.task_id}}", "type": "string"},
            {"id": "10", "name": "fecha_es", "value": "={{$now.setLocale('es').toFormat(\"d LLLL, HH:mm\")}}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "set-alert",
      "name": "Format Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fromEmail": "CAMBIAR_POR_TU_GMAIL@gmail.com",
        "toEmail": "={{$json.destinatario}}",
        "subject": "={{$json.asunto}}",
        "html": "=<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,system-ui,sans-serif;max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5\"><div style=\"padding:16px 28px;border-bottom:1px solid #eeeeee\"><span style=\"font-style:italic;font-size:14px;color:#777777\">Monitorización del pipeline &middot; MedFlow</span></div><div style=\"background:#7f1d1d;padding:18px 28px\"><div style=\"font-size:12px;letter-spacing:2px;color:#fecaca;text-transform:uppercase;font-weight:600\">Fallo de procesamiento</div><div style=\"font-size:20px;font-weight:700;color:#ffffff;margin-top:3px\">Una tarea del pipeline ha fallado</div></div><div style=\"padding:20px 28px 26px\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Detectado &middot; {{$json.fecha_es}}</div><h1 style=\"font-size:25px;line-height:1.3;color:#111111;font-weight:700;margin:10px 0 14px;letter-spacing:-0.5px\">El DAG <span style=\"color:#b91c1c\">{{$json.dag_id}}</span> no ha podido completar la tarea <span style=\"color:#b91c1c\">{{$json.task_id}}</span>.</h1><p style=\"font-size:15px;line-height:1.6;color:#555555;margin:0\">La entrevista asociada no ha llegado al final del pipeline. Revisa los logs de Airflow y reintenta el procesamiento.</p></div><div style=\"padding:24px 28px;border-top:1px solid #eeeeee\"><table style=\"width:100%;border-collapse:collapse\"><tr><td style=\"vertical-align:top;width:30%;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">DAG</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:#111111;padding-bottom:18px\">{{$json.dag_id}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Tarea</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:#111111;padding-bottom:18px\">{{$json.task_id}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Run ID</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:13px;color:#555555;padding-bottom:18px\">{{$json.run_id}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Mensaje</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:13px;line-height:1.55;color:#b91c1c\">{{$json.error}}</td></tr></table></div><div style=\"padding:12px 28px;background:#fafafa;border-top:1px solid #eeeeee\"><span style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;color:#bbbbbb\">GUID {{$json.guid}}</span></div></div>",
        "options": {}
      },
      "id": "email-gmail",
      "name": "Enviar Gmail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [720, 300],
      "credentials": {
        "smtp": {
          "id": "REEMPLAZAR_EN_UI",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.error('[TRIAGE ALERT]', JSON.stringify(item));\nreturn [{json: {status: 'enviado', dag_id: item.dag_id, task_id: item.task_id, guid: item.guid, destinatario: item.destinatario}}];"
      },
      "id": "log-error",
      "name": "Log Console",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Webhook Error": {"main": [[{"node": "Format Alert", "type": "main", "index": 0}]]},
    "Format Alert": {"main": [[{"node": "Enviar Gmail", "type": "main", "index": 0}]]},
    "Enviar Gmail": {"main": [[{"node": "Log Console", "type": "main", "index": 0}]]},
    "Log Console": {"main": [[{"node": "Respond", "type": "main", "index": 0}]]}
  }
}
