{
  "name": "webhook_alerta_clinica",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "alerta-clinica",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-alerta",
      "name": "Webhook Alerta Clinica",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "alerta-clinica-01HXYZABCD000000000000004"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "received_at",
              "value": "={{$now.toISO()}}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "guid",
              "value": "={{$json.body.guid}}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "id_caso",
              "value": "={{$json.body.id_caso || 'N/D'}}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "triage_real",
              "value": "={{$json.body.triage_real}}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "prediccion_ia",
              "value": "={{$json.body.prediccion_ia}}",
              "type": "string"
            },
            {
              "id": "6",
              "name": "score_ansiedad_ia",
              "value": "={{$json.body.score_ansiedad_ia}}",
              "type": "string"
            },
            {
              "id": "7",
              "name": "motivo_fallo",
              "value": "={{$json.body.motivo_fallo}}",
              "type": "string"
            },
            {
              "id": "8",
              "name": "accion_correctiva",
              "value": "={{$json.body.accion_correctiva}}",
              "type": "string"
            },
            {
              "id": "9",
              "name": "destinatario",
              "value": "={{$json.body.destinatario}}",
              "type": "string"
            },
            {
              "id": "10",
              "name": "asunto",
              "value": "=Revisión solicitada · Caso {{$json.body.id_caso || $json.body.guid}}",
              "type": "string"
            },
            {
              "id": "11",
              "name": "fecha_es",
              "value": "={{$now.setLocale('es').toFormat(\"d LLLL, HH:mm\")}}",
              "type": "string"
            },
            {
              "id": "12",
              "name": "sla_min",
              "value": "={{({'C1':0,'C2':10,'C3':60,'C4':120,'C5':240})[$json.body.triage_real]}}",
              "type": "string"
            },
            {
              "id": "13",
              "name": "real_color",
              "value": "={{({'C1':'#d62828','C2':'#f77f00','C3':'#fcbf49','C4':'#43aa8b','C5':'#277da1'})[$json.body.triage_real]}}",
              "type": "string"
            },
            {
              "id": "14",
              "name": "ia_color",
              "value": "={{({'C1':'#d62828','C2':'#f77f00','C3':'#fcbf49','C4':'#43aa8b','C5':'#277da1'})[$json.body.prediccion_ia]}}",
              "type": "string"
            },
            {
              "id": "15",
              "name": "real_desc",
              "value": "={{({'C1':'emergencia — riesgo vital','C2':'muy urgente','C3':'urgencia moderada','C4':'baja urgencia','C5':'no urgente'})[$json.body.triage_real]}}",
              "type": "string"
            },
            {
              "id": "16",
              "name": "ia_desc",
              "value": "={{({'C1':'emergencia — riesgo vital','C2':'muy urgente','C3':'urgencia moderada','C4':'baja urgencia','C5':'no urgente'})[$json.body.prediccion_ia]}}",
              "type": "string"
            },
            {
              "id": "17",
              "name": "score_cualidad",
              "value": "={{Number($json.body.score_ansiedad_ia) >= 0.7 ? 'alto' : (Number($json.body.score_ansiedad_ia) >= 0.4 ? 'moderado' : 'bajo')}}",
              "type": "string"
            },
            {
              "id": "18",
              "name": "score_color",
              "value": "={{Number($json.body.score_ansiedad_ia) >= 0.7 ? '#d62828' : '#333333'}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-alerta",
      "name": "Format Alerta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "CAMBIAR_POR_TU_GMAIL@gmail.com",
        "toEmail": "={{$json.destinatario}}",
        "subject": "={{$json.asunto}}",
        "html": "=<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,system-ui,sans-serif;max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5\"><div style=\"padding:16px 28px;border-bottom:1px solid #eeeeee\"><span style=\"font-style:italic;font-size:14px;color:#777777\">Revisión de Calidad de Triaje &middot; MSKCC</span></div><div style=\"background:#d62828;padding:18px 28px\"><div style=\"font-size:12px;letter-spacing:2px;color:#ffe5e5;text-transform:uppercase;font-weight:600\">Severidad alta</div><div style=\"font-size:20px;font-weight:700;color:#ffffff;margin-top:3px\">Under-triage por sesgo emocional</div></div><div style=\"padding:20px 28px 26px\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Desviación detectada &middot; {{$json.fecha_es}}</div><h1 style=\"font-size:27px;line-height:1.3;color:#111111;font-weight:700;margin:10px 0 14px;letter-spacing:-0.5px\">El modelo asignó <span style=\"color:#d62828\">menor urgencia</span> a un paciente con alta carga emocional.</h1><p style=\"font-size:15px;line-height:1.6;color:#555555;margin:0\">La predicción de la IA difiere de la categoría real correcta. El caso requiere revisión humana antes de cualquier comunicación con el paciente.</p></div><div style=\"padding:22px 28px;border-top:1px solid #eeeeee;border-bottom:1px solid #eeeeee;background:#fafafa\"><table style=\"width:100%;border-collapse:collapse\"><tr><td style=\"vertical-align:top;width:42%\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Categoría real</div><div style=\"font-size:32px;font-weight:800;color:{{$json.real_color}};line-height:1.1;margin:6px 0\">{{$json.triage_real}}</div><div style=\"font-size:13px;color:#777777\">{{$json.real_desc}} &middot; correcto</div></td><td style=\"vertical-align:middle;text-align:center;width:16%;color:#cccccc;font-size:26px\">&rarr;</td><td style=\"vertical-align:top;width:42%\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Predicción IA</div><div style=\"font-size:32px;font-weight:800;color:{{$json.ia_color}};line-height:1.1;margin:6px 0\">{{$json.prediccion_ia}}</div><div style=\"font-size:13px;color:#d62828;font-weight:600\">{{$json.ia_desc}} &middot; error de under-triage</div></td></tr></table></div><div style=\"padding:24px 28px\"><table style=\"width:100%;border-collapse:collapse\"><tr><td style=\"vertical-align:top;width:30%;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Caso</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:#111111;padding-bottom:18px\">{{$json.id_caso}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Score ansiedad</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:{{$json.score_color}};font-weight:600;padding-bottom:18px\">{{$json.score_ansiedad_ia}} &middot; {{$json.score_cualidad}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Hipótesis</td><td style=\"font-size:14px;line-height:1.55;color:#333333;padding-bottom:18px\">{{$json.motivo_fallo}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Acción correctiva</td><td style=\"font-size:14px;line-height:1.55;color:#333333\">{{$json.accion_correctiva}}</td></tr></table></div><div style=\"background:#111111;padding:22px 28px\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#888888;text-transform:uppercase\">Acción requerida</div><div style=\"font-size:17px;font-weight:600;color:#ffffff;margin-top:4px\">Revisar el caso antes de {{$json.sla_min}} min</div></div><div style=\"padding:12px 28px;background:#fafafa;border-top:1px solid #eeeeee\"><span style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;color:#bbbbbb\">GUID {{$json.guid}}</span></div></div>",
        "options": {}
      },
      "id": "email-gmail",
      "name": "Enviar Gmail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REEMPLAZAR_EN_UI",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.warn('[TRIAGE ALERTA CLINICA]', JSON.stringify(item));\nreturn [{json: {status: 'enviado', guid: item.guid, destinatario: item.destinatario}}];"
      },
      "id": "log-alerta",
      "name": "Log Console",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Alerta Clinica": {
      "main": [
        [
          {
            "node": "Format Alerta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Alerta": {
      "main": [
        [
          {
            "node": "Enviar Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Gmail": {
      "main": [
        [
          {
            "node": "Log Console",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Console": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
