{
  "name": "webhook_triaje_procesado",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "triaje-procesado",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-procesado",
      "name": "Webhook Triaje Procesado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        240,
        300
      ],
      "webhookId": "triaje-procesado-01HXYZABCD000000000000005"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {"id": "1", "name": "received_at", "value": "={{$now.toISO()}}", "type": "string"},
            {"id": "2", "name": "guid", "value": "={{$json.body.guid}}", "type": "string"},
            {"id": "3", "name": "id_caso", "value": "={{$json.body.id_caso || $json.body.guid}}", "type": "string"},
            {"id": "4", "name": "clasificacion", "value": "={{$json.body.clasificacion}}", "type": "string"},
            {"id": "5", "name": "score_ansiedad_ia", "value": "={{$json.body.score_ansiedad_ia != null ? $json.body.score_ansiedad_ia : 'N/D'}}", "type": "string"},
            {"id": "6", "name": "resumen", "value": "={{$json.body.resumen ? (String($json.body.resumen).length > 240 ? String($json.body.resumen).slice(0, 240).trimEnd() + '...' : String($json.body.resumen)) : 'Sin resumen disponible.'}}", "type": "string"},
            {"id": "7", "name": "destinatario", "value": "={{$json.body.destinatario || $env.CLINICO_EMAIL}}", "type": "string"},
            {"id": "8", "name": "asunto", "value": "=Triaje urgente {{$json.body.clasificacion}} · Caso {{$json.body.id_caso || $json.body.guid}}", "type": "string"},
            {"id": "9", "name": "fecha_es", "value": "={{$now.setLocale('es').toFormat(\"d LLLL, HH:mm\")}}", "type": "string"},
            {"id": "10", "name": "nivel_color", "value": "={{({'C1':'#d62828','C2':'#f77f00','C3':'#fcbf49','C4':'#43aa8b','C5':'#277da1'})[$json.body.clasificacion]}}", "type": "string"},
            {"id": "11", "name": "nivel_desc", "value": "={{({'C1':'emergencia - riesgo vital','C2':'muy urgente','C3':'urgencia moderada','C4':'baja urgencia','C5':'no urgente'})[$json.body.clasificacion]}}", "type": "string"}
          ]
        },
        "options": {}
      },
      "id": "set-procesado",
      "name": "Format Procesado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "CAMBIAR_POR_TU_GMAIL@gmail.com",
        "toEmail": "={{$json.destinatario}}",
        "subject": "={{$json.asunto}}",
        "html": "=<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,system-ui,sans-serif;max-width:600px;margin:0 auto;background:#ffffff;border:1px solid #e5e5e5\"><div style=\"padding:16px 28px;border-bottom:1px solid #eeeeee\"><span style=\"font-style:italic;font-size:14px;color:#777777\">Triaje procesado &middot; MedFlow</span></div><div style=\"background:{{$json.nivel_color}};padding:18px 28px\"><div style=\"font-size:12px;letter-spacing:2px;color:#ffffff;opacity:0.85;text-transform:uppercase;font-weight:600\">Nivel {{$json.clasificacion}} &middot; {{$json.nivel_desc}}</div><div style=\"font-size:20px;font-weight:700;color:#ffffff;margin-top:3px\">Nueva entrevista clasificada como urgente</div></div><div style=\"padding:20px 28px 26px\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Procesada desde la web &middot; {{$json.fecha_es}}</div><h1 style=\"font-size:25px;line-height:1.3;color:#111111;font-weight:700;margin:10px 0 14px;letter-spacing:-0.5px\">Un paciente ha sido clasificado en nivel <span style=\"color:{{$json.nivel_color}}\">{{$json.clasificacion}}</span>.</h1><p style=\"font-size:15px;line-height:1.6;color:#555555;margin:0\">El pipeline de triaje ha completado el caso. Revisa la clasificación antes de la gestión asistencial.</p></div><div style=\"padding:22px 28px;border-top:1px solid #eeeeee;border-bottom:1px solid #eeeeee;background:#fafafa\"><div style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;margin-bottom:8px\">Resumen del caso</div><p style=\"font-size:14px;line-height:1.6;color:#333333;margin:0;font-style:italic\">{{$json.resumen}}</p></div><div style=\"padding:24px 28px\"><table style=\"width:100%;border-collapse:collapse\"><tr><td style=\"vertical-align:top;width:30%;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase;padding-bottom:18px\">Caso</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:#111111;padding-bottom:18px\">{{$json.id_caso}}</td></tr><tr><td style=\"vertical-align:top;font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:11px;letter-spacing:1.5px;color:#999999;text-transform:uppercase\">Score ansiedad</td><td style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:14px;color:#111111\">{{$json.score_ansiedad_ia}}</td></tr></table></div><div style=\"padding:12px 28px;background:#fafafa;border-top:1px solid #eeeeee\"><span style=\"font-family:'SF Mono',ui-monospace,Menlo,Consolas,monospace;font-size:10px;color:#bbbbbb\">GUID {{$json.guid}}</span></div></div>",
        "options": {}
      },
      "id": "email-gmail",
      "name": "Enviar Gmail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        720,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "REEMPLAZAR_EN_UI",
          "name": "Gmail SMTP"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconsole.warn('[TRIAGE PROCESADO]', JSON.stringify(item));\nreturn [{json: {status: 'enviado', guid: item.guid, clasificacion: item.clasificacion, destinatario: item.destinatario}}];"
      },
      "id": "log-procesado",
      "name": "Log Console",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "allIncomingItems",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Triaje Procesado": {
      "main": [
        [
          {
            "node": "Format Procesado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Procesado": {
      "main": [
        [
          {
            "node": "Enviar Gmail",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Enviar Gmail": {
      "main": [
        [
          {
            "node": "Log Console",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Console": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
